{
  "name": "cloudflare-controller",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "platform/core/cloudflare-controller",
  "tags": [],
  "metadata": {
    "manifestsValuesPath": "cloudflare-controller/values.yaml"
  },
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "platform/core/cloudflare-controller",
        "command": "go tool controller-gen object crd rbac:roleName=cloudflare-controller paths=./api/v1alpha1/... paths=./cmd/... paths=./internal/... output:crd:artifacts:config=chart/templates output:rbac:artifacts:config=chart/templates"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "platform/core/cloudflare-controller",
        "command": "go build ./..."
      }
    },
    "build-ci": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/docker-build-and-push.sh platform/core/cloudflare-controller/Dockerfile platform/core/cloudflare-controller kbntx/cloudflare-controller:$IMAGE_TAG"
      }
    }
  }
}
