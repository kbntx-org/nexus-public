load('ext://helm_resource', 'helm_resource', 'helm_repo')
load('./lib.tilt', 'helm_chart_deps', 'bootstrap_kubernetes', 'root_path', 'REGISTRY_REF')

DOCKER_CONTEXT = "kind-kind"
update_settings(max_parallel_updates=6)

default_registry(REGISTRY_REF)

CORE_RESOURCES = ['cilium', 'vault', 'external-secrets', 'traefik', 'metrics-server-repo', 'metrics-server', 'cloudnative-pg', 'rustfs', 'watch-ingresses', 'headlamp']
OPTIONAL_RESOURCES = ['monitoring', 'grafana-mcp', 'playwright-mcp']
PERSISTED_ON_DOWN = ['cloudnative-pg', 'cilium']

bootstrap_kubernetes(DOCKER_CONTEXT)

# ── Cilium (CNI + kube-proxy replacement; kind's own CNI/kube-proxy are off, ──
# ── see local.sh, so nothing else can schedule until this is installed) ────
if config.tilt_subcommand != 'down':
  KUBE_APISERVER_HOST = str(local(
    "docker inspect --format='{{ .NetworkSettings.Networks.kind.IPAddress }}' kind-control-plane",
    quiet=True,
  )).strip()
else:
  KUBE_APISERVER_HOST = ''

helm_chart_deps(root_path('platform/core/cilium'))
helm_resource(
  'cilium',
  root_path('platform/core/cilium'),
  namespace='kube-system',
  flags=[
    '--values', root_path('platform/core/cilium/values.local.yaml'),
    '--set-string', 'cilium.k8sServiceHost=' + KUBE_APISERVER_HOST,
    '--set-string', 'cilium.k8sServicePort=6443',
  ],
  deps=[root_path('platform/core/cilium')],
  labels=['2-Infra'],
  links=[link('http://hubble.localhost', 'hubble.localhost')],
)

helm_chart_deps(root_path('platform/core/external-secrets/deploy'))
helm_resource(
  'external-secrets',
  root_path('platform/core/external-secrets/deploy'),
  namespace='external-secrets',
  flags=['--create-namespace'],
  deps=[root_path('platform/core/external-secrets')],
  labels=['2-Infra'],
)

helm_repo(
  'metrics-server-repo',
  'https://kubernetes-sigs.github.io/metrics-server/',
  labels=['2-Infra'],
)

helm_resource(
  'metrics-server',
  'metrics-server-repo/metrics-server',
  namespace='kube-system',
  flags=[
    '--version=3.13.0',
    '--set-json=args=["--kubelet-insecure-tls", "--kubelet-preferred-address-types=InternalIP"]',
  ],
  resource_deps=['metrics-server-repo'],
  labels=['2-Infra'],
)

helm_resource(
  'vault',
  root_path('platform/core/vault/server'),
  namespace='default',
  flags=[
    '--values', root_path('platform/core/vault/server/values.local.yaml'),
    '--create-namespace',
  ],
  deps=[root_path('platform/core/vault/server')],
  labels=['2-Infra'],
  links=[link('http://vault.localhost', 'vault.localhost')],
)

# ── RustFS (S3-compatible object storage for product services' local dev) ──────
helm_resource(
  'rustfs',
  root_path('platform/core/rustfs'),
  namespace='default',
  deps=[root_path('platform/core/rustfs')],
  labels=['2-Infra'],
  links=[
    link('http://s3.localhost', 'S3 API'),
    link('http://s3-console.localhost', 'Console'),
  ],
)

# ── Traefik (auto-started as a dependency of all product services) ─────────────
helm_chart_deps(root_path('platform/core/traefik'))
helm_resource(
  'traefik',
  root_path('platform/core/traefik'),
  deps=[root_path('platform/core/traefik')],
  namespace='traefik',
  flags=[
    '--create-namespace',
    '--values', root_path('platform/core/traefik/values.local.yaml'),
  ],
  labels=['2-Infra'],
)

# ── Ingress TLS watcher (reissues the local mkcert cert whenever a new IngressRoute host appears) ──
local_resource(
  'watch-ingresses',
  serve_cmd=[root_path('platform/core/local/local.sh'), 'watch-ingresses'],
  deps=[root_path('platform/core/local/local.sh')],
  resource_deps=['traefik'],
  labels=['2-Infra'],
)

# ── Headlamp (Kubernetes dashboard) ───────────────────────────────────────────
helm_chart_deps(root_path('platform/core/headlamp'))
helm_resource(
  'headlamp',
  root_path('platform/core/headlamp'),
  namespace='headlamp',
  flags=[
    '--values', root_path('platform/core/headlamp/values.local.yaml'),
    '--create-namespace',
  ],
  deps=[root_path('platform/core/headlamp')],
  resource_deps=['traefik'],
  labels=['2-Infra'],
  links=[link('http://headlamp.localhost', 'headlamp.localhost')],
)

# ── CloudNative-PG (Postgres operator, required by monitoring) ────────────────
helm_chart_deps(root_path('platform/core/cloudnative-pg'))
helm_resource(
  'cloudnative-pg',
  root_path('platform/core/cloudnative-pg'),
  namespace='cloudnative-pg',
  flags=['--create-namespace'],
  deps=[root_path('platform/core/cloudnative-pg')],
  labels=['2-Infra'],
)

# ── Monitoring (VictoriaMetrics + Grafana + Loki + node/kube-state metrics) ───
helm_chart_deps(root_path('platform/core/monitoring'))
helm_resource(
  'monitoring',
  root_path('platform/core/monitoring'),
  namespace='monitoring',
  flags=[
    '--values', root_path('platform/core/monitoring/values.local.yaml'),
    '--create-namespace',
  ],
  deps=[root_path('platform/core/monitoring')],
  resource_deps=['vault', 'external-secrets', 'cloudnative-pg', 'traefik'],
  labels=['2-Infra'],
  links=[link('http://grafana.localhost', 'grafana.localhost')],
)

# ── Grafana MCP (lets AI agents query dashboards, metrics and logs, of the Grafana set in env.yaml) ──
# renovate: datasource=docker depName=grafana/mcp-grafana
GRAFANA_MCP_IMAGE = 'grafana/mcp-grafana:2.0.1'
grafana = read_yaml(root_path('env.yaml'), default=read_yaml(root_path('env.example.yaml')))['grafana']
local_resource(
  'grafana-mcp',
  serve_cmd='exec docker run --rm --network host --env GRAFANA_URL --env GRAFANA_USERNAME --env GRAFANA_PASSWORD --env GRAFANA_SERVICE_ACCOUNT_TOKEN --volume /etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro {image} --transport streamable-http --usage-stats=disabled'.format(
    image=GRAFANA_MCP_IMAGE,
  ),
  serve_env={
    'GRAFANA_URL': grafana['url'],
    'GRAFANA_USERNAME': grafana.get('username', ''),
    'GRAFANA_PASSWORD': grafana.get('password', ''),
    'GRAFANA_SERVICE_ACCOUNT_TOKEN': grafana.get('serviceAccountToken', ''),
  },
  readiness_probe=probe(tcp_socket=tcp_socket_action(port=8000)),
  labels=['2-Infra'],
)

# ── Playwright MCP (headless Chromium driven by AI agents to check frontend changes) ──
# Host networking, because Chromium always resolves *.localhost to its own loopback: on the VM's,
# kind publishes Traefik on 80/443. The image has no certutil to trust the mkcert CA, hence
# --ignore-https-errors. Snapshots and console logs are written to files the tool responses point
# to, so the output directory is mounted at the same path for those paths to resolve in the VM.
# renovate: datasource=docker depName=mcr.microsoft.com/playwright/mcp
PLAYWRIGHT_MCP_IMAGE = 'mcr.microsoft.com/playwright/mcp:v0.0.83'
PLAYWRIGHT_MCP_PORT = '8931'
PLAYWRIGHT_MCP_OUTPUT_DIR = root_path('.playwright-mcp')
local_resource(
  'playwright-mcp',
  serve_cmd='mkdir -p {output} && exec docker run --rm --network host --user "$(id -u):$(id -g)" --env HOME=/tmp --volume {output}:{output} --workdir {workdir} {image} --port {port} --isolated --ignore-https-errors --output-dir {output}'.format(
    output=PLAYWRIGHT_MCP_OUTPUT_DIR,
    workdir=root_path('.'),
    image=PLAYWRIGHT_MCP_IMAGE,
    port=PLAYWRIGHT_MCP_PORT,
  ),
  readiness_probe=probe(tcp_socket=tcp_socket_action(port=int(PLAYWRIGHT_MCP_PORT))),
  labels=['2-Infra'],
)
