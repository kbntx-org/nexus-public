load('ext://helm_resource', 'helm_resource')
load('./lib.tilt', 'buildkit_build', 'mise_tool_version', 'root_path')

PRODUCT_RESOURCES = ['docs', 'kiln', 'portfolio']

NODE_VERSION = mise_tool_version('node')
PNPM_VERSION = mise_tool_version('pnpm')
GO_VERSION = mise_tool_version('go')

# ── Docs ──────────────────────────────────────────────────────────────────────
buildkit_build(
  'documentation',
  root_path('docs'),
  target='local',
  live_update=[
    sync(root_path('docs/src'), '/workspace/src'),
    sync(root_path('docs/mkdocs.yml'), '/workspace/mkdocs.yml'),
  ],
)

helm_resource(
  'docs',
  root_path('docs/helm'),
  deps=[root_path('docs/helm')],
  image_deps=['documentation'],
  image_keys=[('image.repository', 'image.tag')],
  namespace='default',
  flags=[
    '--values', root_path('docs/helm/values.local.yaml'),
    '--create-namespace',
  ],
  links=[link('http://docs.localhost', 'docs.localhost')],
  labels=['1-Product'],
)

# ── Kiln ──────────────────────────────────────────────────────────────────────
buildkit_build(
  'kiln',
  root_path('platform/services/kiln/server'),
  dockerfile=root_path('platform/services/kiln/Dockerfile'),
  target='local-backend',
  build_args={'GO_VERSION': GO_VERSION},
  only=[
    root_path('platform/services/kiln/server'),
    root_path('platform/services/kiln/Dockerfile'),
  ],
  live_update=[
    # go.mod/go.sum need `go mod download` re-run, and .air.toml is air's own config, so
    # both fall back to a full image rebuild; everything else just gets synced in place.
    fall_back_on([
      root_path('platform/services/kiln/server/go.mod'),
      root_path('platform/services/kiln/server/go.sum'),
      root_path('platform/services/kiln/server/.air.toml'),
    ]),
    sync(root_path('platform/services/kiln/server'), '/workspace'),
  ],
)

buildkit_build(
  'kiln-client',
  root_path('.'),
  dockerfile=root_path('platform/services/kiln/Dockerfile'),
  target='local-client',
  build_args={'NODE_VERSION': NODE_VERSION, 'PNPM_VERSION': PNPM_VERSION},
  only=[
    root_path('platform/services/kiln/client'),
    root_path('platform/services/kiln/Dockerfile'),
    root_path('tsconfig.base.json'),
    root_path('pnpm-lock.yaml'),
    root_path('pnpm-workspace.yaml'),
    root_path('package.json'),
    root_path('.pnpmfile.mjs'),
  ],
  live_update=[
    # Everything besides src/ (package.json, index.html, ...) falls outside this sync,
    # so it falls back to a full image rebuild instead.
    sync(root_path('platform/services/kiln/client/src'), '/usr/src/app/platform/services/kiln/client/src'),
  ],
)

helm_resource(
  'kiln',
  root_path('platform/services/kiln/chart'),
  deps=[root_path('platform/services/kiln/chart')],
  image_deps=['kiln', 'kiln-client'],
  image_keys=[('image.repository', 'image.tag'), ('frontend.image.repository', 'frontend.image.tag')],
  namespace='default',
  flags=[
    '--values', root_path('platform/services/kiln/chart/values.local.yaml'),
    '--create-namespace',
  ],
  links=[link('http://kiln.localhost', 'kiln.localhost')],
  labels=['1-Product'],
)

# ── Portfolio ─────────────────────────────────────────────────────────────────
buildkit_build(
  'portfolio',
  root_path('.'),
  dockerfile=root_path('apps/portfolio/Dockerfile'),
  target='local',
  build_args={'NODE_VERSION': NODE_VERSION, 'PNPM_VERSION': PNPM_VERSION},
  only=[
    root_path('apps/portfolio'),
    root_path('tsconfig.base.json'),
    root_path('nx.json'),
    root_path('tools'),
    root_path('pnpm-lock.yaml'),
    root_path('package.json'),
    root_path('.pnpmfile.mjs'),
    root_path('pnpm-workspace.yaml'),
  ],
  live_update=[
    sync(root_path('apps/portfolio/src'), '/usr/src/app/apps/portfolio/src'),
    sync(root_path('tsconfig.base.json'), '/usr/src/app/tsconfig.base.json'),
  ],
)

helm_resource(
  'portfolio',
  root_path('apps/portfolio/chart'),
  deps=[root_path('apps/portfolio/chart')],
  image_deps=['portfolio'],
  image_keys=[('image.repository', 'image.tag')],
  namespace='default',
  flags=[
    '--values', root_path('apps/portfolio/chart/values.local.yaml'),
    '--create-namespace',
  ],
  links=[link('http://portfolio.localhost', 'portfolio.localhost')],
  labels=['1-Product'],
)
