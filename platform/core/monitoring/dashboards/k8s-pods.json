            "uid": "mimir"
          },
          "expr": "sum(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\", namespace=~\"$namespace\", pod=~\"$pod\"}) or vector(0)",
          "legendFormat": ""
