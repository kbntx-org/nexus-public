    {
      "type": "timeseries",
      "title": "Error rate",
      "description": "5xx are server failures. A steady 4xx share is normal (not found, conflicts on updates).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(apiserver_request_total{code=~\"5..\"}[$__rate_interval])) / sum(rate(apiserver_request_total[$__rate_interval]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(apiserver_request_total{code=~\"4..\"}[$__rate_interval])) / sum(rate(apiserver_request_total[$__rate_interval]))",
