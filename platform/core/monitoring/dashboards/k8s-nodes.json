      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(node_load1{instance=~\"$node\"}) / count(node_cpu_seconds_total{mode=\"idle\", instance=~\"$node\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
