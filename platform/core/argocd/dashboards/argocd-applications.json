    {
      "type": "table",
      "title": "Auto-sync overridden",
      "description": "Applications whose live auto-sync differs from autoSync in their argo.yaml, usually the incident switch in the Argo CD UI. Switch it back in the UI, or change argo.yaml if the override should stay.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "((max by (name, autosync_enabled) (argocd_app_info{project=~\"$project\", name=~\"$application\"}) unless on (name, autosync_enabled) label_replace(max by (name, label_nexus_auto_sync) (argocd_app_labels{project=~\"$project\", name=~\"$application\", label_nexus_auto_sync!=\"\"}), \"autosync_enabled\", \"$1\", \"label_nexus_auto_sync\", \"(.*)\")) and on (name) label_replace(max by (name, label_nexus_auto_sync) (argocd_app_labels{project=~\"$project\", name=~\"$application\", label_nexus_auto_sync!=\"\"}), \"autosync_enabled\", \"$1\", \"label_nexus_auto_sync\", \"(.*)\")) * on (name) group_left (label_nexus_auto_sync) max by (name, label_nexus_auto_sync) (argocd_app_labels{project=~\"$project\", name=~\"$application\", label_nexus_auto_sync!=\"\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "name": 0,
              "label_nexus_auto_sync": 1,
              "autosync_enabled": 2
            },
            "renameByName": {
              "name": "Application",
              "label_nexus_auto_sync": "Auto-sync in Git",
              "autosync_enabled": "Auto-sync live"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
