    {
      "type": "stat",
      "title": "Auto-sync overridden",
      "description": "Applications whose auto-sync was switched in the Argo CD UI and no longer matches autoSync in their argo.yaml.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count((max by (name, autosync_enabled) (argocd_app_info{project=~\"$project\", name=~\"$application\"}) unless on (name, autosync_enabled) label_replace(max by (name, label_nexus_auto_sync) (argocd_app_labels{project=~\"$project\", name=~\"$application\", label_nexus_auto_sync!=\"\"}), \"autosync_enabled\", \"$1\", \"label_nexus_auto_sync\", \"(.*)\")) and on (name) label_replace(max by (name, label_nexus_auto_sync) (argocd_app_labels{project=~\"$project\", name=~\"$application\", label_nexus_auto_sync!=\"\"}), \"autosync_enabled\", \"$1\", \"label_nexus_auto_sync\", \"(.*)\")) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
