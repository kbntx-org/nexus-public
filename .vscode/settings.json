{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "npm.packageManager": "pnpm",
  "editor.formatOnSave": true,
  "go.lintTool": "golangci-lint-v2",
  "go.lintFlags": ["--path-mode=abs", "--fast-only", "--config=${workspaceFolder}/.golangci.yml"],
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "~/.local/share/mise/shims/golangci-lint",
    "golangci-lint-v2": "/Users/kenny/.local/share/mise/shims/golangci-lint",
    "golangci-lint": "/Users/kenny/.local/share/mise/shims/golangci-lint"
  },
  "go.formatFlags": ["fmt", "--stdin"],
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[typescript][typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.removeUnusedImports": "always"
    }
  },
  "[terraform][terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "vs-kubernetes": {
    "disable-linters": ["resource-limits"]
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "yaml.format.enable": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .pnpmfile.mjs",
    "Tiltfile": ".tiltignore",
    "README.md": "LICENSE, CLAUDE.md",
    "mise.toml": "mise.lock",
    ".prettierrc": ".prettierignore"
  },
  "files.associations": {
    "Tiltfile": "tiltfile",
    "*.tilt": "tiltfile"
  },
  "material-icon-theme.files.associations": {
    "Tiltfile": "Tilt",
    "*.tilt": "Tilt"
  }
}
