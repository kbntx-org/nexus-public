{
  "name": "portfolio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portfolio/src",
  "tags": [],
  "metadata": {
    "manifestsValuesPath": "portfolio/values.yaml"
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/portfolio"],
      "options": {
        "cwd": "apps/portfolio",
        "command": "tsc -b && vite build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/portfolio",
        "command": "vite"
      }
    },
    "build-ci": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/docker-build-and-push.sh apps/portfolio/Dockerfile . kbntx/portfolio:$IMAGE_TAG --build-arg NODE_VERSION=$(mise current node) --build-arg PNPM_VERSION=$(mise current pnpm)"
      }
    }
  }
}
