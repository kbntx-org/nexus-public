{
  "permissions": {
    "allow": ["WebFetch(domain:docs.github.com)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(*.tfvars)",
      "Read(**/*.tfvars)",
      "Read(*.tfvars.json)",
      "Read(**/*.tfvars.json)",
      "Read(vars.yaml)",
      "Read(**/vars.yaml)",
      "Read(vars.*.yaml)",
      "Read(**/vars.*.yaml)",
      "Bash(kubectl *)"
    ]
  }
}
