{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "useInferencePlugins": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "toolchain"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "toolchain": [],
    "goToolchain": ["{workspaceRoot}/.config/mise/conf.d/go.toml"],
    "nodeToolchain": ["{workspaceRoot}/.config/mise/conf.d/node.toml"],
    "miseToolchain": ["{workspaceRoot}/mise.toml"]
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true,
      "analyzePackageJson": true,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "build-ci": {
      "inputs": ["production", "^production"]
    }
  },
  "parallel": 1,
  "generators": {
    "@nx/react": {
      "application": {
        "style": "scss",
        "linter": "none",
        "bundler": "vite",
        "unitTestRunner": "jest"
      },
      "component": {
        "style": "scss"
      },
      "library": {
        "style": "scss",
        "linter": "none",
        "unitTestRunner": "jest",
        "skipPackageJson": true
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "analytics": false
}
